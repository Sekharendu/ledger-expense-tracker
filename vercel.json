{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist",
  "framework": null,
  "functions": {
    "api/index.mjs": {
      "maxDuration": 300,
      "includeFiles": "{server/**,src/expenses.ts,src/email/**,node_modules/pdfjs-dist/**}"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/((?!_expo/|assets/|favicon.ico).*)", "destination": "/index.html" }
  ]
}

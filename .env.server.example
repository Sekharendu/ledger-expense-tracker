# Private Vercel environment (or ignored .env.server for developer testing).
SUPABASE_URL=
SUPABASE_SECRET_KEY=
TOKEN_ENCRYPTION_KEY=
CRON_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Optional authenticated Gmail push delivery. Never put private keys in these fields.
GMAIL_PUBSUB_TOPIC=
GMAIL_PUBSUB_SUBSCRIPTION=
GMAIL_PUBSUB_SERVICE_ACCOUNT=
GMAIL_PUBSUB_AUDIENCE=
# Set true only after the 15-minute Supabase recovery job is activated.
EMAIL_RECOVERY_ENABLED=false
# Comma-separated approved web origins, including the deployed Vercel origin.
ALLOWED_ORIGINS=

  "narrative": {
    "northStar": "Personal account statement",
    "overview": "Ledger uses the calm precision of a personal account statement: cream working space, dark chocolate anchors, and caramel actions. The approved direction is classy and minimalist, with an approximate 60% cream, 30% dark chocolate, and 10% caramel visual balance.\n\nNative system sans typography, aligned financial figures, open sections, and restrained rounded controls keep bookkeeping readable. This is an Android-first React Native system; code is the design authority.",
    "keyCharacteristics": [
      "Cream workspace and dark chocolate statement/navigation anchors.",
      "Caramel for action, selection, refunds, and category bars.",
      "Native system sans with tabular financial figures.",
      "Flat surfaces, precise dividers, and generous working margins."
    ],
    "rules": [
      {
        "name": "60–30–10 balance",
        "body": "Cream 60%, dark chocolate 30%, caramel 10%; medium brown supports text and pressed states. Proportions guide visual emphasis rather than a pixel quota.",
        "section": "colors"
      },
      {
        "name": "Readable accents",
        "body": "Use white on solid caramel buttons and medium brown for small action text on cream. Preserve text labels for semantic states.",
        "section": "colors"
      }
    ],
    "dos": [
      "Do use the shared theme for new screens and shared settings controls.",
      "Do keep spending and outstanding obligations visually distinct.",
      "Do preserve native font scaling, safe areas, and wrapping or stacking behavior.",
      "Do use the existing 24-unit stroke icon vocabulary."
    ],
    "donts": [
      "Don't introduce decorative raster artwork into the working interface.",
